# --- Server ---
PORT=3000

# Shared request timeout (milliseconds) used by every API client below.
API_TIMEOUT=30000

# --- Lloyd's List Intelligence SeaSearcher (vessel sanctions screening) ---
SEASEARCHER_BASE_URL=https://api.lloydslistintelligence.com/v1
SEASEARCHER_USERNAME=
SEASEARCHER_PASSWORD=

# --- Vartion Pascal (company/entity risk & sanctions cases) ---
PASCAL_BASE_URL=https://app.pascal.vartion.com
# Sent as: Authorization: Bearer <PASCAL_AUTH_TOKEN>
PASCAL_AUTH_TOKEN=
PASCAL_ORG_ID=

# --- PortAble Agent (portcalls) ---
PORTABLE_BASE_URL=
PORTABLE_EMAIL=
PORTABLE_PASSWORD=
